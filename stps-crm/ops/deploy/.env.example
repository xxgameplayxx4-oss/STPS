# STPS CRM – Umgebungsvariablen (Produktion: /etc/stps-crm.env, Rechte 600, Besitzer root; nie ins Git!)

# --- Server ---
PORT=8888
HOST=127.0.0.1
# ENABLE_SCHEDULES=0   # Zeitpläne (Erinnerungen, Zertifikate, FX, Outlook, SharePoint) abschalten
NODE_ENV=production
# PFLICHT in Produktion (NODE_ENV=production oder DB_DRIVER gesetzt): Der Server startet NICHT, wenn TRUST_PROXY fehlt.
#   TRUST_PROXY=1    hinter nginx: Client-IP aus X-Real-IP lesen (Login-Sperre je IP). NUR wenn der Port nur über nginx erreichbar ist (HOST=127.0.0.1).
#   TRUST_PROXY=off  bewusst ohne IP-Sperre (nur Verzögerung je Benutzername), z. B. bei direktem Internetzugriff: X-Real-IP/X-Forwarded-For wären fälschbar.
TRUST_PROXY=1

# --- Speicher (Infomaniak Managed MySQL) ---
DB_DRIVER=mysql
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=1
# DB_POOL=4

# --- Anmeldung ---
# PFLICHT, mind. 32 Zeichen, zufällig: openssl rand -hex 32 (kürzer: Server startet nicht in Produktion, die API meldet «nicht konfiguriert»)
CRM_SECRET=
# Nur für die Erst-Anmeldung des Superadmins; danach entfernen. Der Entwicklungsmodus (ohne Passwort) gilt in Produktion nie: er braucht CRM_DEV_MODE=on bzw. `netlify dev`.
CRM_PASSWORD=
CRM_ADMIN_USER=
# CRM_ADMIN_RESET=
# CRM_DEV_MODE=off     # "off" schaltet den Entwicklungsmodus sicher ab (er ist ohnehin nur lokal aktiv; NIE =on setzen)
# SP_TEAM_ID=

# --- Öffentliche URL (Links in Mails/Push; in Produktion PFLICHT für «Outlook verbinden»: die Rückleit-Adresse wird nie aus dem Host-Header abgeleitet) ---
APP_URL=https://crm.example.ch

# --- Benachrichtigungen (optional) ---
# Web Push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.ch
# E-Mail über Resend
RESEND_API_KEY=
MAIL_FROM=

# --- Microsoft 365 / SharePoint / Outlook (optional) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
SP_SITE=
SP_DRIVE=
SP_IMPORT_PATH=
SP_EXPORT_FOLDER=
# Überschreibt die App-Einstellung für den Outlook-Kalender (sonst MS_*)
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=
