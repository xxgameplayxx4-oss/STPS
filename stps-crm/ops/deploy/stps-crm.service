[Unit]
Description=STPS CRM (Node.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stps
Group=stps
WorkingDirectory=/opt/stps/stps-crm
EnvironmentFile=/etc/stps-crm.env
ExecStart=/usr/bin/node server/server.mjs
Restart=always
RestartSec=3
# Härtung
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/stps

[Install]
WantedBy=multi-user.target
